# Mako Configuration - Enhanced Notification System

# Positioning and layout
anchor=top-right
margin=10
width=400
height=150

# Text and content
max-visible=5
sort=-time
max-history=50
text-alignment=left
markup=1
actions=1
format=<b>%s</b>\n%b
font=Inter 11

# Colors and styling (dark theme)
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
progress-color=#89b4fa

# Border and effects
border-size=2
border-radius=10

# Urgency levels
[urgency=low]
background-color=#181825
text-color=#a6adc8
border-color=#6c7086
default-timeout=4000

[urgency=normal]
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
default-timeout=8000

[urgency=critical]
background-color=#f38ba8
text-color=#11111b
border-color=#f38ba8
default-timeout=0

# App-specific styling
[app-name="Brave"]
background-color=#313244
border-color=#f9e2af
text-color=#f9e2af

