font=GeistMono Nerd Font 11
anchor=top-right
margin=14
padding=14
width=380
height=160
max-visible=5
sort=-time
max-history=50
markup=1
actions=1
format=<b>%s</b>\n%b

background-color=#24153ed9
text-color=#f3ecfb
border-color=#ffffff1f
progress-color=over #f5b8da66
border-size=1
border-radius=16

[urgency=low]
text-color=#f3ecfbaa
default-timeout=4000

[urgency=normal]
default-timeout=8000

[urgency=critical]
border-color=#f48fb1
border-size=2
default-timeout=0

[app-name="Volume"]
default-timeout=2000

[app-name="Brightness"]
default-timeout=2000
