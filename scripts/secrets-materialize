#!/usr/bin/env bash
# Rebuilds secret files from rbw (Bitwarden) into RAM: $XDG_RUNTIME_DIR/secrets (tmpfs, 0700, gone at logout).
# The old on-disk paths are symlinks into it, so tools keep using the same paths with no plaintext on disk.
#   secrets-materialize              rebuild everything (needs rbw unlocked)
#   secrets-materialize --if-missing do nothing when every file exists; used by the 5-min timer after a reboot
# Source of truth: rbw folder "Huggian/Secrets", entries named "<prefix>/<KEY>".
set -euo pipefail

DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/secrets"
FOLDER="Huggian/Secrets"
# target file  |  format  |  rbw name prefix
TARGETS=(
  "yt-project.env|dotenv|yt-project/"
  "zeroclaw-mail.credentials|gmail|zeroclaw/GMAIL_APP_PASSWORD"
  "aurora-calendars|field|iCal Secret#ical secret"
)

all_present() {
  local t
  for t in "${TARGETS[@]}"; do [[ -s "$DIR/${t%%|*}" ]] || return 1; done
}

if [[ "${1:-}" == "--if-missing" ]] && all_present; then exit 0; fi

if ! rbw unlocked >/dev/null 2>&1; then
  echo "rbw is locked: unlock it (any rbw command, e.g. 'rbw unlock') and the timer will rebuild the files." >&2
  exit 75  # EX_TEMPFAIL
fi

umask 077
mkdir -p "$DIR"
chmod 700 "$DIR"
names="$(rbw list --fields name,folder | awk -F'\t' -v f="$FOLDER" '$2 == f {print $1}')"

write() {  # write <file> <content> atomically
  local tmp
  tmp="$(mktemp "$DIR/.tmp.XXXXXX")"
  printf '%s' "$2" > "$tmp"
  mv -f "$tmp" "$DIR/$1"
}

for t in "${TARGETS[@]}"; do
  IFS='|' read -r file format prefix <<<"$t"
  case "$format" in
    dotenv)
      content=""
      while IFS= read -r name; do
        [[ "$name" == "$prefix"* ]] || continue
        content+="${name#"$prefix"}=$(rbw get --folder "$FOLDER" "$name")"$'\n'
      done <<<"$names"
      [[ -n "$content" ]] || { echo "no rbw entries under $prefix" >&2; exit 1; }
      write "$file" "$content"
      ;;
    gmail)
      user="$(rbw get --folder "$FOLDER" --field username "$prefix")"
      write "$file" "user=$user"$'\n'"app_password=$(rbw get --folder "$FOLDER" "$prefix")"$'\n'
      ;;
    field)
      value="$(rbw get --field "${prefix#*#}" "${prefix%%#*}")"
      [[ -n "$value" ]] || { echo "rbw entry ${prefix%%#*} has no field ${prefix#*#}" >&2; exit 1; }
      write "$file" "$value"$'\n'
      ;;
  esac
done
echo "secrets rebuilt in $DIR"
