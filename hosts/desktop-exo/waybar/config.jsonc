{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "cpu",
    "memory",
    "network#speed"
  ],
  "modules-right": [
    "tray",
    "pulseaudio#mic",
    "pulseaudio",
    "network",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "✦",
      "default": "✧",
      "empty": "·"
    },
    "persistent-workspaces": {
      "DP-1": [
        1,
        2,
        3,
        4,
        5
      ],
      "HDMI-A-1": [
        6,
        7,
        8,
        9,
        10
      ]
    },
    "disable-scroll": true
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 3,
    "tooltip": false
  },
  "memory": {
    "format": "󰘚 {percentage}%",
    "interval": 5
  },
  "network#speed": {
    "interval": 2,
    "format": "󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "format-disconnected": "",
    "tooltip": false
  },
  "tray": {
    "spacing": 10,
    "icon-size": 15
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "<span color='#f48fb1'>󰍭</span>",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}  {ipaddr}"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/theme/aurora/power-menu.sh"
  }
}
